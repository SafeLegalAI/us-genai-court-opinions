{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "SafeLegalAI decision on generative AI",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "decision_id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]{3,90}$"
  },
  "case_name": {
   "type": "string",
   "maxLength": 200
  },
  "court": {
   "type": "string",
   "maxLength": 120
  },
  "court_code": {
   "type": [
    "string",
    "null"
   ],
   "description": "CourtListener court id if known (e.g. ca2, nysd, cal)"
  },
  "court_level": {
   "type": "string",
   "enum": [
    "federal-supreme",
    "federal-appellate",
    "federal-district",
    "federal-bankruptcy",
    "federal-specialty",
    "state-supreme",
    "state-appellate",
    "state-trial",
    "tribal",
    "other"
   ]
  },
  "state": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[A-Z]{2}$",
   "description": "US state/territory code; null for federal courts unless it is a district court (then the state it sits in)"
  },
  "date_filed": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "citation": {
   "type": [
    "string",
    "null"
   ]
  },
  "docket_number": {
   "type": [
    "string",
    "null"
   ]
  },
  "document_type": {
   "type": "string",
   "enum": [
    "opinion",
    "memorandum-opinion",
    "order",
    "concurrence",
    "dissent",
    "administrative-order",
    "report-and-recommendation",
    "other"
   ]
  },
  "topics": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "enum": [
     "fabricated-citations",
     "court-ai-use",
     "evidence-authentication",
     "discovery-ediscovery",
     "privilege-work-product",
     "unauthorized-practice",
     "criminal-justice-algorithms",
     "pro-se-ai-use",
     "competence-fees",
     "rules-by-opinion",
     "substantive-ai-law"
    ]
   }
  },
  "primary_topic": {
   "type": "string",
   "enum": [
    "fabricated-citations",
    "court-ai-use",
    "evidence-authentication",
    "discovery-ediscovery",
    "privilege-work-product",
    "unauthorized-practice",
    "criminal-justice-algorithms",
    "pro-se-ai-use",
    "competence-fees",
    "rules-by-opinion",
    "substantive-ai-law"
   ]
  },
  "court_used_ai": {
   "type": "boolean",
   "description": "true only if the court states it used an AI tool itself"
  },
  "ai_tool_named": {
   "type": [
    "string",
    "null"
   ],
   "description": "tool named in the document, verbatim; null if none"
  },
  "disposition": {
   "type": "string",
   "maxLength": 240,
   "description": "what the court did, in one sentence"
  },
  "ai_passage": {
   "type": "string",
   "minLength": 40,
   "maxLength": 4000,
   "description": "verbatim passage about AI from the document (public domain); ellipses allowed"
  },
  "cited_authorities": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "cases/rules the AI passage cites, e.g. 'Mata v. Avianca, 678 F. Supp. 3d 443 (S.D.N.Y. 2023)'"
  },
  "summary": {
   "type": "string",
   "minLength": 120,
   "maxLength": 520,
   "description": "40–60 words, descriptive, present tense"
  },
  "incident": {
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "description": "only for fabricated-citations rows",
   "properties": {
    "conduct": {
     "type": "string",
     "maxLength": 300
    },
    "outcome": {
     "type": "string",
     "enum": [
      "sanctions",
      "fine",
      "costs-order",
      "referral",
      "warning",
      "strike-off",
      "suspension",
      "dismissal",
      "pending",
      "other"
     ]
    },
    "actor": {
     "type": "string",
     "enum": [
      "lawyer",
      "litigant-in-person",
      "prosecutor",
      "judge",
      "expert",
      "firm",
      "other"
     ]
    },
    "monetary_penalty": {
     "type": [
      "number",
      "null"
     ]
    },
    "currency": {
     "type": [
      "string",
      "null"
     ]
    },
    "ai_tool": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "conduct",
    "outcome",
    "actor"
   ]
  },
  "tracker_slug": {
   "type": [
    "string",
    "null"
   ],
   "description": "safelegalai.com/tracker/<slug> if this decision is already in the incident tracker"
  },
  "courtlistener_url": {
   "type": [
    "string",
    "null"
   ]
  },
  "text_sha256": {
   "type": [
    "string",
    "null"
   ]
  },
  "source_url": {
   "type": "string",
   "format": "uri",
   "description": "primary source (court/regulator/legislature/agency/vendor own site or official API)"
  },
  "archive_url": {
   "type": [
    "string",
    "null"
   ],
   "description": "web.archive.org snapshot of source_url, or null"
  },
  "fetched_at": {
   "type": "string",
   "description": "ISO timestamp of the read"
  },
  "verification": {
   "type": "string",
   "enum": [
    "fetched-and-read",
    "page-read-no-document",
    "link-only",
    "mirror-read"
   ],
   "description": "fetched-and-read = official copy read; mirror-read = the court-authored document was read from a public mirror (e.g. the PDF held by a public database such as Damien Charlotin's, CC BY 4.0) and the official URL is pending; page-read-no-document; link-only"
  },
  "lead_source": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "where we learned the row exists (tracker/news/api/crawl); never a source_url"
  },
  "notes": {
   "type": [
    "string",
    "null"
   ],
   "maxLength": 600
  }
 },
 "required": [
  "decision_id",
  "case_name",
  "court",
  "court_level",
  "date_filed",
  "document_type",
  "topics",
  "primary_topic",
  "court_used_ai",
  "disposition",
  "ai_passage",
  "summary",
  "source_url",
  "fetched_at",
  "verification",
  "lead_source"
 ]
}